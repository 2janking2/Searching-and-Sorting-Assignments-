import java.util.Scanner;

public class Sorting {
    public static void main(String[] args) {
        Scanner input = new Scanner(System.in);

        int[] expenses = new int[5];

        System.out.println("===== DAILY EXPENSE SORTER =====");

        for (int i = 0; i < expenses.length; i++) {
            System.out.print("Enter expense " + (i + 1) + ": ");
            expenses[i] = input.nextInt();
        }

        // Bubble Sort
        for (int i = 0; i < expenses.length - 1; i++) {
            for (int j = 0; j < expenses.length - 1 - i; j++) {

                if (expenses[j] > expenses[j + 1]) {
                    int temp = expenses[j];
                    expenses[j] = expenses[j + 1];
                    expenses[j + 1] = temp;
                }
            }
        }

        System.out.println("\nExpenses from Cheapest to Most Expensive:");

        for (int i = 0; i < expenses.length; i++) {
            System.out.println("PHP " + expenses[i]);
        }

        input.close();
    }
}
