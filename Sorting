import java.util.Scanner;

public class Sorting {
    public static void main(String[] args) {
        Scanner input = new Scanner(System.in);

        int[] expenses = new int[5];

        System.out.println("|||||| DAILY EXPENSE SORTER BY ALAN ||||||");

        for (int i = 0; i < expenses.length; i++) {
            System.out.print("Enter expense " + (i + 1) + ": ");
            expenses[i] = input.nextInt();
        }
        for (int i = 0; i < expenses.length; i++) {
            for (int j = i + 1; j < expenses.length; j++) {

                if (expenses[i] > expenses[j]) {
                    int temp = expenses[i];
                    expenses[i] = expenses[j];
                    expenses[j] = temp;
                }
            }
        }

        System.out.println("Expenses from Cheapest to Most Expensive:");

        for (int i = 0; i < expenses.length; i++) {
            System.out.println("PHP " + expenses[i]);
        }
        input.close();
    }
}
